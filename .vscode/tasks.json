{
  "version": "2.0.0",
  "tasks": [
     {
      "label": "tail Docker",
      "type": "shell",
      "command": "tail -f /C/Docker/log/apache/error.log",
      "options": {
        "statusbar": {
          "label": "tail Docker",
          "color": "#08e050"
        }
      }
    },
    {
      "label": "phpcs",
      "type": "shell",
      "command": "phpcs",
      "options": {
        "statusbar": {
          "label": "phpcs",
          "color": "#08e050"
        }
      }
    },
    {
      "label": "phpunit",
      "type": "shell",
      "command": "php-check-coverage-nivel",
      "args": [
        "${input:nivel-coverage}"
        ],
      "options": {
        "statusbar": {
          "label": "phpunit",
          "color": "#08e050"
        }
      }
    },
    {
      "label": "phpstan",
      "type": "shell",
      "command": "phpstan-nivel",
      //"args": ["9"],  //Alterar para nao passar o valor
      "args": [
        "${input:niveis-phpstan}"
        ],
      "options": {
        "statusbar": {
          "label": "phpstan",
          "color": "#08e050"
        }
      }
    },
    {
      "label": "sonar",
      "type": "shell",
      "args": [
        "-D'sonar.projectKey=${workspaceFolderBasename}'",
        "-D'sonar.sources=.'",
        "-D'sonar.host.url=http://localhost:9002'",
        "-D'sonar.login=${input:chaveSonar}'"
      ],
      "command": "sonar-scanner.bat",
      "options": {
        "statusbar": {
          "label": "sonar",
          //"backgroundColor": "statusBarItem.errorBackground"
          "color": "#08e050",
          //"hide": true
      },
      },
    }
  ] ,
  "inputs" : [
    /*{
      "type": "pickString",
      "id": "niveis-phpstan",
      "options": [
        {
          "label": "Nivel 9",
          "value": "9"
        },
        {
          "label": "Nivel 8",
          "value": "8"
        }
      ],
      "description": "Escolha o Nível do Phpstan"
    }*/
    {
      "type": "promptString",
      "id": "chaveSonar",
      "description": "Digite o Token do Sonar"
    },
    {
      "type": "promptString",
      "id": "niveis-phpstan",
      "description": "Digite o Nível do PHPSTAN de 0 a 9"
    },
    {
      "type": "promptString",
      "id": "nivel-coverage",
      "description": "Digite o Percentual do PHPUNIT de 0 a 100%"
    }
  ]
}
